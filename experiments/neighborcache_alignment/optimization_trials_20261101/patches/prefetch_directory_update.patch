+template <typename T, typename LabelT>
+void PQFlashIndex<T, LabelT>::neighborcache_dyn_loc_refresh_unlocked(uint32_t node_id, const NeighborCacheDiskLoc &loc)
+{
+    const NeighborCacheDiskLoc replacement = loc;
+    NeighborCacheDynLocShard &shard = neighborcache_dyn_loc_shard(node_id);
+    NeighborCacheTimedSharedMutexGuard lock(shard.mu, NeighborCacheLockKind::DynamicUnique, true);
+    auto &locations = shard.locations[node_id];
+    // Match erase-sector + add ordering without deleting the hash key or
+    // temporarily clearing its canonical route. A republished page must still
+    // become the first route, even when this member's slot did not change.
+    locations.erase(std::remove_if(locations.begin(), locations.end(),
+                                  [&](const NeighborCacheDiskLoc &old) { return old.sector == replacement.sector; }),
+                    locations.end());
+    locations.insert(locations.begin(), replacement);
+    neighborcache_canon_publish(node_id, replacement);
+}
