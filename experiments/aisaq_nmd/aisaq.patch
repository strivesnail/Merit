+void execute_io(io_context_t ctx, int fd, std::vector<AlignedRead> &read_reqs, uint64_t = 0)
+{
+    for (size_t start = 0; start < read_reqs.size(); start += MAX_EVENTS) {
+        const size_t count = std::min(read_reqs.size() - start, (size_t)MAX_EVENTS);
+        std::vector<iocb_t> cb(count);
+        std::vector<iocb_t *> cbs(count);
+        std::vector<io_event_t> events(count);
+        for (size_t j = 0; j < count; ++j) {
+            auto &req = read_reqs[start + j];
+            if (req.fd_override < 0) {
+                assert(IS_ALIGNED(req.len, 512));
+                assert(IS_ALIGNED(req.offset, 512));
+                assert(IS_ALIGNED(req.buf, 512));
+            }
+            req.result = -EIO;
+            io_prep_pread(&cb[j], req.fd_override >= 0 ? req.fd_override : fd,
+                          req.buf, req.len, req.offset);
+            cb[j].data = &req;
+            cbs[j] = &cb[j];
+        }
+        size_t submitted = 0, completed = 0;
+        while (submitted < count || completed < submitted) {
+            if (submitted < count) {
+                const long n = io_submit(ctx, count - submitted, cbs.data() + submitted);
+                if (n > 0) submitted += n;
+                else if (n == -EINTR) continue;
+                else if (n != -EAGAIN || submitted == completed) {
+                    // Retain the error for this request; drain accepted requests safely.
+                    read_reqs[start + submitted].result = n < 0 ? n : -EIO;
+                    ++submitted;
+                    ++completed;
+                }
+            }
+            if (completed < submitted) {
+                const long n = io_getevents(ctx, 1, submitted - completed, events.data(), nullptr);
+                if (n == -EINTR) continue;
+                if (n <= 0) {
+                    std::cerr << "io_getevents failed: " << n << std::endl;
+                    std::abort(); // Outstanding buffers cannot safely be released.
+                }
+                for (long j = 0; j < n; ++j) {
+                    auto *req = static_cast<AlignedRead *>(events[j].data);
+                    req->result = events[j].res2 ? -EIO : (int64_t)events[j].res;
+                }
+                completed += n;
+            }
+        }
+        for (size_t j = 0; j < count; ++j) {
+            const auto &req = read_reqs[start + j];
+            if (req.fd_override < 0 && req.result != (int64_t)req.len)
+                throw std::runtime_error("Base-index read failed or was short");
+        }
+    }
